<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: same rule for Google backup and for moving to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="account.xml" />
        <exclude domain="sharedpref" path="pro.xml" />
        <exclude domain="sharedpref" path="alarm_diag.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="account.xml" />
        <exclude domain="sharedpref" path="pro.xml" />
        <exclude domain="sharedpref" path="alarm_diag.xml" />
    </device-transfer>
</data-extraction-rules>
