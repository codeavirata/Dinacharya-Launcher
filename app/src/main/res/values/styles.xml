<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Every screen is frosted glass over a ground. "Night" is Graphite & Amber, the default (and what shows while a screen opens);
         "Day" is White & Black, a Pro choice made in Settings. The ground itself and the colours are set in Ui. -->
    <style name="AppNight" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#FFFFB84D</item>
        <item name="android:colorAccent">#FFFFC66B</item>
        <item name="android:windowBackground">@drawable/ground_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:alertDialogTheme">@style/GlassDialogNight</item>
        <item name="android:timePickerDialogTheme">@style/GlassDialogNight</item>
        <item name="android:datePickerDialogTheme">@style/GlassDialogNight</item>
        <item name="android:spinnerStyle">@style/GlassSpinnerNight</item>
    </style>

    <style name="AppDay" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#FF111111</item>
        <item name="android:colorAccent">#FF111111</item>
        <item name="android:windowBackground">@drawable/ground_day</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:alertDialogTheme">@style/GlassDialogDay</item>
        <item name="android:timePickerDialogTheme">@style/GlassDialogDay</item>
        <item name="android:datePickerDialogTheme">@style/GlassDialogDay</item>
        <item name="android:spinnerStyle">@style/GlassSpinnerDay</item>
    </style>

    <style name="AppTheme" parent="AppNight" />

    <!-- Dialogs: frosted glass, graphite on Graphite & Amber and white on White & Black. -->
    <style name="GlassDialogNight" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/glass_dialog_night</item>
        <item name="android:colorAccent">#FFFFC66B</item>
    </style>

    <style name="GlassDialogDay" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/glass_dialog_day</item>
        <item name="android:colorAccent">#FF111111</item>
    </style>

    <!-- The drop-down list of a choice box. -->
    <style name="GlassSpinnerNight" parent="@android:style/Widget.Material.Spinner">
        <item name="android:popupBackground">@drawable/glass_dialog_night</item>
    </style>

    <style name="GlassSpinnerDay" parent="@android:style/Widget.Material.Light.Spinner">
        <item name="android:popupBackground">@drawable/glass_dialog_day</item>
    </style>

    <!-- The home screen: the phone's wallpaper shows through, behind transparent system bars. -->
    <style name="LauncherTheme" parent="@android:style/Theme.Material.Wallpaper.NoTitleBar">
        <item name="android:windowShowWallpaper">true</item>
        <!-- Dark while the app starts again after a force stop; the code makes the window see-through once the live wallpaper is confirmed. -->
        <item name="android:windowBackground">@color/launcher_start</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:alertDialogTheme">@style/GlassDialogNight</item>
        <item name="android:timePickerDialogTheme">@style/GlassDialogNight</item>
        <item name="android:datePickerDialogTheme">@style/GlassDialogNight</item>
    </style>

    <!-- The lock and pause screen that comes up over an app when the strong lock is on (the colours are set in code). -->
    <style name="GuardTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The tour: dark from the first frame, so it does not flash light. -->
    <style name="TourTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/ground_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:alertDialogTheme">@style/GlassDialogNight</item>
    </style>
</resources>
