<?xml version="1.0" encoding="utf-8"?>
<!-- Only in the "shots" build (a test build for taking pictures of the whole app). It adds one icon, "Dinacharya shots",
     that walks through every screen and saves a picture of each. It is not in the debug build or the Google Play bundle. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".ShotActivity"
            android:exported="true"
            android:label="Dinacharya shots"
            android:launchMode="singleTask"
            android:theme="@style/TourTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ShotStage"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/GuardTheme" />
    </application>
</manifest>
